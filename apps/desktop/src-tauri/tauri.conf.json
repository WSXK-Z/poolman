{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "poolmen",
  "version": "0.1.11",
  "identifier": "com.wushi.poolmen",
  "build": {
    "beforeDevCommand": "pnpm build:extension && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "i am poolmen",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": {
      "../../extension/.output/chrome-mv3": "chrome-mv3"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
